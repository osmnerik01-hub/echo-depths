{
  "name": "echo-depths",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.mjs",
    "test:playthrough": "node scripts/playthrough.mjs",
    "test:production": "npm run build && playwright test --config playwright.production.config.js",
    "profile:browser": "node scripts/profile-browser.mjs",
    "profile:compare": "node scripts/compare-profile.mjs",
    "gpu:probe": "node scripts/probe-gpu.mjs",
    "gpu:compare": "node scripts/compare-gpu.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.1.0"
  }
}
